PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/subtracker?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Email — set either EMAIL_USER/EMAIL_PASS (Gmail shorthand)
# or MAIL_HOST/MAIL_PORT/MAIL_USER/MAIL_PASSWORD (generic SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password

# Billing reminder cron schedule (default: 9 AM daily in IST)
BILLING_REMINDER_CRON=0 9 * * *
REMINDER_TIME_ZONE=Asia/Kolkata

# Client URL for CORS (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173